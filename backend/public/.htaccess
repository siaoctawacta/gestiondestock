# MM Cosmétiques Stock Pro — un seul sous-domaine pour l'application et l'API
# (Apache / LiteSpeed, hébergement cPanel LWS). Racine du sous-domaine = ce dossier public/.
#   /api/…            → API Laravel (index.php)
#   fichiers présents → servis tels quels (assets/, uploads/, logos…)
#   toute autre URL   → application React (index.html), qui gère ses pages (/pos, /stores…)

DirectoryIndex index.html index.php

<IfModule mod_negotiation.c>
    Options -MultiViews -Indexes
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Forcer HTTPS (activez d'abord le certificat SSL dans cPanel)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Transmettre l'en-tête Authorization (jeton de connexion) à PHP
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # API Laravel
    RewriteRule ^(api|up)(/.*)?$ index.php [L]

    # Fichiers et dossiers existants
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Application monopage
    RewriteRule ^ index.html [L]
</IfModule>

# Fichiers sensibles : jamais servis
<FilesMatch "^\.(env|git|ht)">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # index.html jamais en cache (pour recevoir les mises à jour)…
    <FilesMatch "index\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    # …les fichiers de assets/ ont un nom unique par version : cache long
    <FilesMatch "\.(js|css|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
