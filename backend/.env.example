# =====================================================================
# MM Cosmétiques Stock Pro — configuration du backend Laravel
# Copier en .env sur le serveur, puis lancer : php artisan key:generate
# =====================================================================

APP_NAME="MM Cosmétiques Stock Pro"
APP_ENV=production
APP_KEY=
# Toujours false en production (sinon les erreurs affichent des informations sensibles)
APP_DEBUG=false
# Adresse publique du sous-domaine (application + API sous /api), racine = dossier public/
APP_URL=https://stockpro.mmconsultingtg.com
# Heure : UTC (configuration Laravel), identique à l’heure de Lomé toute l’année
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# Adresse de l'application : liens « mot de passe oublié » et autorisation CORS.
# Même adresse que APP_URL quand tout est sur un seul sous-domaine.
# Plusieurs adresses possibles, séparées par des virgules.
FRONTEND_URL=https://stockpro.mmconsultingtg.com

# Durée d'une connexion avant de devoir se reconnecter (jours)
TOKEN_DAYS=30

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Base MySQL créée dans cPanel (« Bases de données MySQL »). Sur cPanel, le nom
# de la base et de l'utilisateur sont préfixés par votre identifiant cPanel.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_mmstock
DB_USERNAME=cpaneluser_mmstock
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Envoi des emails (« mot de passe oublié ») via une boîte email de l'hébergement
# (cPanel → Comptes de messagerie). Adresse d'exemple : à remplacer par la vôtre.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.mmconsultingtg.com
MAIL_PORT=465
MAIL_USERNAME=stockpro@mmconsultingtg.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=stockpro@mmconsultingtg.com
MAIL_FROM_NAME="MM Cosmétiques"

BCRYPT_ROUNDS=12
