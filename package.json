{
  "name": "mm-cosmetiques-stock-pro",
  "private": true,
  "description": "Raccourcis : le frontend (frontend/) et le backend Supabase (backend/) sont deux projets indépendants.",
  "scripts": {
    "setup": "npm --prefix frontend install",
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "test": "npm --prefix frontend test",
    "typecheck": "npm --prefix frontend run typecheck",
    "seed:sql": "npm --prefix frontend run seed:sql",
    "db:start": "cd backend && supabase start",
    "db:test": "cd backend && supabase test db"
  }
}
